# ==============================================================================
# CYBERSHIELD — GITIGNORE CONFIGURATION
# Prevents sensitive credentials, API keys, logs, and build artifacts from leaking.
# ==============================================================================

# Private Firebase Service Account Keys & Secrets
firebase_key.json
backend/firebase_key.json
*.pem
*.key
*.p12

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/

# Node.js & Dependency Directories
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Operating System Files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary Files
*.log
tmp/
temp/
